# Copier ce fichier en .env (cp .env.example .env) puis changer les mots de passe.

# --- Order service ---
ORDER_DB_NAME=orderdb
ORDER_DB_USER=order_user
ORDER_DB_PASSWORD=change_me
ORDER_DB_HOST=order-db
ORDER_DB_PORT=5432
ORDER_SERVICE_PORT=8081

# --- Carrier service (SOAP) ---
CARRIER_DB_NAME=carrierdb
CARRIER_DB_USER=carrier_user
CARRIER_DB_PASSWORD=change_me
CARRIER_DB_HOST=carrier-db
CARRIER_DB_PORT=5432
CARRIER_SERVICE_PORT=8082

# --- Tracking service (gRPC) ---
TRACKING_DB_NAME=trackingdb
TRACKING_DB_USER=tracking_user
TRACKING_DB_PASSWORD=change_me
TRACKING_DB_HOST=tracking-db
TRACKING_DB_PORT=5432
TRACKING_SERVICE_PORT=8083
TRACKING_GRPC_PORT=9090

# --- API Gateway ---
GATEWAY_PORT=8080
